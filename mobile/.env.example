# Copia este archivo a .env y llena los valores de tu proyecto de Supabase
# (Project Settings -> API Keys en el dashboard de supabase.com)
# Expo solo expone al app las variables que empiezan con EXPO_PUBLIC_, y TODAS
# quedan dentro de la app: usa la clave publicable, nunca la sb_secret_.

EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_tu-clave

# URL de la web (para el link de referido que comparten los vendedores)
EXPO_PUBLIC_SITE_URL=https://tu-dominio.com
