# Copia este archivo a .env.local y llena los valores de tu proyecto de Supabase
# (Project Settings → API Keys en el dashboard de supabase.com)

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Usa la clave PUBLICABLE (sb_publishable_... o la "anon" legacy). Nunca la sb_secret_ aquí:
# todo lo que empieza con NEXT_PUBLIC_ termina en el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_tu-clave

# --- Solo servidor (nunca con prefijo NEXT_PUBLIC_) ---
# Clave secreta (sb_secret_... o "service_role" legacy). La usan las rutas /api
# para crear reservas y confirmar pagos de Wompi.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_tu-clave

# Wompi (dashboard de comercio → Desarrolladores). Empieza con las llaves de
# pruebas (pub_test_ / test_integrity_ / test_events_) y la URL sandbox.
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
WOMPI_EVENTS_SECRET=test_events_xxx
WOMPI_API_URL=https://sandbox.wompi.co/v1
